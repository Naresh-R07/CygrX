# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Overrides the project AI model for Gemini calls.
# The active model is resolved as: GEMINI_MODEL > metadata.json "aiModel" > default.
# Available free-tier models (all 1M token context): gemini-3.6-flash,
# gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash.
# If a selected model is unavailable/over-quota, the server auto-falls back
# to the next healthy model in the registry.
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
